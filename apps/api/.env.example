PORT=3100
ALLOWED_QQ_GROUPS=460309159,1002072430
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional override for the overlay stream-key secret (HS256 JWT signing).
# Left empty, the API generates a random secret on first boot and stores it in
# axsuck.app_secrets (migration 010), so no manual setup is needed. Set it only
# to rotate the secret or to share one across several instances.
STREAM_KEY_SECRET=
